# Copy to backend/.env and fill in. Never commit the real .env.

# Auth — required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=

# Database
MONGODB_URL=mongodb://localhost:27017

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Ollama (LLM explanations + screenshot OCR)
OLLAMA_URL=http://localhost:11434

# Blockchain (Sepolia) — required at startup
RPC_URL=
PRIVATE_KEY=
ACCOUNT_ADDRESS=
CONTRACT_ADDRESS=
KYC_CONTRACT_ADDRESS=
