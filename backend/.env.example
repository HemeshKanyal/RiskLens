# Copy to backend/.env and fill in. Never commit the real .env.

# Auth — required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=

# Database
MONGODB_URL=mongodb://localhost:27017

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Language model for explanations and screenshot import:
#   "ollama" (local, free, needs a GPU-ish machine) or "gemini" (hosted API)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=moondream
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Barretenberg CLI used to verify identity proofs (default: bb on PATH or ~/.bb/bb)
BB_PATH=
